{
    "compilerOptions": {
        "lib": [
            "deno.ns",
            "es2022"
        ],
        "strict": true
    },
    "exports": "./src/index.ts",
    "imports": {
        "@yankeeinlondon/kind-error": "npm:@yankeeinlondon/kind-error@^1.4.1",
        "~": "./src/index.ts",
        "~/ast": "./src/ast/index.ts",
        "~/cache": "./src/cache/index.ts",
        "~/cli": "./src/cli/index.ts",
        "~/commands": "./src/commands/index.ts",
        "~/errors": "./src/errors.ts",
        "~/logging": "./src/logging/index.ts",
        "~/report": "./src/report/index.ts",
        "~/type-guards": "./src/type-guards/index.ts",
        "~/types": "./src/types/index.ts",
        "~/utils": "./src/utils/index.ts",
        "chalk": "npm:^5.5.0",
        "command-line-args": "npm:^6.0.1",
        "command-line-usage": "npm:^7.0.3",
        "fast-glob": "npm:^3.3.3",
        "inferred-types": "npm:inferred-types@^0.55.23",
        "ts-morph": "npm:^26.0.0",
        "tty-table": "npm:^4.2.3",
        "undici": "npm:undici@^7.10.0"
    },
    "license": "MIT",
    "name": "@yankeeinlondon/typed-tester",
    "publish": {
        "exclude": [
            ".env",
            ".ai/",
            ".claude/",
            "CLAUDE.md",
            "test/",
            "tests/",
            "dist/",
            "bin/",
            "node_modules/",
            ".github/",
            "*.config.*",
            "package.json",
            "package-lock.json",
            "pnpm-lock.yaml",
            "scripts/",
            "sigma/"
        ],
        "include": [
            "README.md",
            "deno.jsonc",
            "src/**/*.ts",
            "!src/**/*.test.ts",
            "!src/sounds/**/*"
        ]
    },
    "tasks": {
        "fmt": "deno fmt src/",
        "lint": "deno lint src/",
        "test": "deno test --allow-net"
    },
    "version": "0.10.6"
}
