{
    "name": "typed-tester",
    "version": "0.11.6",
    "description": "Test all your type-tests and incorporate into your CI-CD and deployment strategy",
    "keywords": [
        "typescript",
        "testing"
    ],
    "license": "MIT",
    "author": "Ken Snyder <ken@ken.net>",
    "type": "module",
    "bin": {
        "typed": "bin/typed"
    },
    "files": [
        "package.json",
        "bin"
    ],
    "scripts": {
        "build": "npm-run-all build:clean build:mkdir build:transpile build:copy build:chmod build:success",
        "build:chmod": "node -e \"const fs = require('fs'); const os = require('os'); if (os.platform() !== 'win32') { fs.chmodSync('./bin/typed', '755'); console.log('- granted execute permissions to ./bin/typed'); } else { console.log('- skipped chmod on Windows (not needed)'); }\"",
        "build:clean": "rimraf ./bin",
        "build:copy": "node -e \"require('fs').copyFileSync('./src/typed', './bin/typed'); console.log('- copied ./src/typed shell script to ./bin directory');\"",
        "build:mkdir": "node -e \"require('fs').mkdirSync('./bin', { recursive: true }); console.log('- created ./bin directory');\"",
        "build:success": "node -e \"console.log('\\n- 🚀 build successful\\n');\"",
        "build:transpile": "tsdown src/typed.ts --format=esm -d bin --sourcemap",
        "diagnostics": "bun run ./scripts/get-diagnostics.ts",
        "lint": "eslint src",
        "release": "bumpp",
        "test": "vitest run unit",
        "test:coverage": "vitest run --coverage",
        "test:integration": "vitest run integration",
        "test:ui": "vitest --ui",
        "test:watch": "vitest",
        "try": "bun run ./src/typed.ts",
        "watch": "tsup src/typed.ts --format=esm -d bin --sourcemap --watch"
    },
    "dependencies": {
        "@yankeeinlondon/kind-error": "^1.4.1",
        "chalk": "^5.6.0",
        "command-line-args": "^6.0.1",
        "command-line-usage": "^7.0.3",
        "cytoscape": "^3.33.1",
        "fast-glob": "^3.3.3",
        "find-root": "^1.1.0",
        "graphology": "^0.26.0",
        "inferred-types": "^0.55.23",
        "pathe": "^2.0.3",
        "play-sound": "^1.1.6",
        "repo-root": "1.0.0-beta.2",
        "sigma": "^3.0.2",
        "stack-trace": "1.0.0-pre2",
        "ts-morph": "^26.0.0",
        "tty-table": "^4.2.3",
        "watcher": "^2.3.1"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^5.2.2",
        "@type-challenges/utils": "^0.1.1",
        "@types/command-line-args": "^5.2.3",
        "@types/command-line-usage": "^5.0.4",
        "@types/find-root": "^1.1.4",
        "@types/node": "^22.18.1",
        "@types/stack-trace": "^0.0.33",
        "@yankeeinlondon/claudine": "^0.4.1",
        "@yankeeinlondon/gotcha": "^0.2.3",
        "bumpp": "^10.2.3",
        "chalk": "^5.5.0",
        "eslint": "^9.35.0",
        "eslint-plugin-format": "^1.0.1",
        "husky": "^9.1.7",
        "jiti": "^2.5.1",
        "npm-run-all": "^4.1.5",
        "rimraf": "^6.0.1",
        "tsdown": "^0.14.2",
        "tsup": "^8.5.0",
        "typescript": "^5.9.2",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^3.2.4"
    },
    "peerDependencies": {
        "typescript": "~5.9.2"
    },
    "tsup": {
        "entry": [
            "src/typed.ts"
        ],
        "format": "esm",
        "sourcemap": true,
        "splitting": false
    }
}
