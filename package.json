{
    "name": "typed-tester",
    "version": "0.13.1",
    "description": "Test all your type-tests and incorporate into your CI-CD and deployment strategy",
    "keywords": [
        "typescript",
        "testing"
    ],
    "license": "MIT",
    "author": "Ken Snyder <ken@ken.net>",
    "type": "module",
    "bin": {
        "typed": "./bin/typed.js"
    },
    "files": [
        "package.json",
        "bin"
    ],
    "scripts": {
        "build": "bun run scripts/build.ts",
        "build:transpile": "tsdown src/typed.ts --format=esm -d bin --sourcemap",
        "build:shebang": "echo '#/usr/bin/env bun run'",
        "diagnostics": "bun run ./scripts/get-diagnostics.ts",
        "lint": "eslint src",
        "release": "bumpp",
        "test": "vitest run unit",
        "test:jsr": "./scripts/jsr-validation",
        "test:types": "pnpm typed test",
        "test:all": "vitest run",
        "test:coverage": "COVERAGE=1 vitest run --coverage",
        "test:coverage:ui": "vitest --ui --coverage",
        "test:coverage:watch": "vitest --coverage",
        "test:integration": "vitest run integration",
        "test:ui": "vitest --ui",
        "report:start-position": "bun run .claude/skills/scripts/start-position.ts",
        "test:watch": "vitest",
        "try": "bun run ./src/typed.ts",
        "typed": "node ./bin/typed.js",
        "watch": "tsup src/typed.ts --format=esm -d bin --sourcemap --watch"
    },
    "dependencies": {
        "@yankeeinlondon/kind-error": "^1.4.1",
        "chalk": "^5.6.2",
        "command-line-args": "^6.0.1",
        "command-line-usage": "^7.0.3",
        "cytoscape": "^3.33.1",
        "fast-glob": "^3.3.3",
        "find-root": "^1.1.0",
        "graphology": "^0.26.0",
        "pathe": "^2.0.3",
        "play-sound": "^1.1.6",
        "repo-root": "1.0.0-beta.2",
        "sigma": "^3.0.2",
        "stack-trace": "1.0.0-pre2",
        "ts-morph": "^27.0.2",
        "tty-table": "^4.2.3",
        "watcher": "^2.3.1"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^6.0.0",
        "@type-challenges/utils": "^0.1.1",
        "@types/command-line-args": "^5.2.3",
        "@types/command-line-usage": "^5.0.4",
        "@types/find-root": "^1.1.4",
        "@types/node": "^22.18.11",
        "@types/stack-trace": "^0.0.33",
        "@vitest/coverage-v8": "^3.2.4",
        "@yankeeinlondon/claudine": "^0.4.1",
        "@yankeeinlondon/gotcha": "^0.2.3",
        "bumpp": "^10.3.1",
        "chalk": "^5.5.0",
        "eslint": "^9.38.0",
        "eslint-plugin-format": "^1.0.2",
        "husky": "^9.1.7",
        "inferred-types": "^1.2.3",
        "jiti": "^2.6.1",
        "npm-run-all": "^4.1.5",
        "rimraf": "^6.0.1",
        "simple-git": "^3.28.0",
        "tsdown": "^0.15.9",
        "typescript": "^5.9.3",
        "vitest": "^3.2.4"
    },
    "peerDependencies": {
        "inferred-types": "^1.2.3",
        "typescript": "~5.9.2"
    }
}
